        <text:p text:style-name="P4717"><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 4 Copy 4 Copy 3 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 4 Copy 4 Copy 3 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 4 Copy 4 Copy 3 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6760">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 4 Copy 4 Copy 3 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6760">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7216">Hablando del software libre como propuestas de servicio voluntario </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7181">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7216">Qué otras herramientas o extensiones necesitan los proyectos PSeInt y ZinjaI para soportar la potencia de la </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7217">programación científica</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7188">?</text:span></text:span></text:p>
