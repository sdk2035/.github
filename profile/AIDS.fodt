        <text:p text:style-name="P4667"><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7040">Le declarará la guerra ficticia a su abuelita o no se le ocurre mejor idea que donar todo su armamento a la española por que sus voluntarias están buenas y las rusas no le entienden</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7036">?</text:span></text:span></text:p>
