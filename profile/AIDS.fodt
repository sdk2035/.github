       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4442"><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6197"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173417_40617152241111111112111111111111111111111212111212212121112121331111112213121212212112112211121111321111111111111111411211112311111111111111221111111111211"/><text:bookmark-end text:name="__DdeLink__155131_"/><text:bookmark-end text:name="__DdeLink__173375_21222656242111111112111111111111111111111212111212212121112121331111112213121212212112112211121111321111111111111111411211112311111111111111221111111111211"/><text:bookmark-end text:name="__DdeLink__173307_347296314813111111112111111111111111111111212111212212121112121331111112213121212212112112211121111321111111111111111411211112311111111111111221111111111211"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6521">Eso sería algo muy pretencioso o predecible de mi parte</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6487">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6390"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6521">empezaremos con las mujeres jóvenes del instituto y luego con las niñas de la primaria…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_"/><text:bookmark-start text:name="__DdeLink__108668_"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_"/><