       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P5579"><text:span text:style-name="Emphasis"><text:span text:style-name="T9081">Estudiante: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9096">¿Algunas niñas pueden </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9098">ir juntas al baño</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9096"> durante la matiné en el teatro</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9091">?</text:span></text:span></text:p>
