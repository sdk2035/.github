       <text:list-item>
        <text:p text:style-name="P682"><text:span text:style-name="T205">Experto: </text:span><text:span text:style-name="T1024">Realizando un </text:span><text:span text:style-name="T1025">examen de descarte periódico</text:span><text:span text:style-name="T1024"> que dura aproximadamente un mes</text:span><text:span text:style-name="T994">...</text:span><text:span text:style-name="T787"> </text:span><text:span text:style-name="T209">&quot;</text:span><text:span text:style-name="T1026">y ya que tiene un costo mínimo debería incluirse dentro de los gastos para un viaje de campamento o un paseo en yate…</text:span><text:span text:style-name="T209">&quot;</text:span><text:bookmark-end text:name="__DdeLink__88190_1899904804"/></text:p>
