       <text:list-item>
        <text:p text:style-name="P5689"><text:span text:style-name="Emphasis"><text:span text:style-name="T8998">Experto: No conozco al Sr. Nefilim... </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9099">“por otro lado, mientras más grande</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9255">s</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T9099"> sean sus libros; tanto mayor y grave será su caída…”</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
