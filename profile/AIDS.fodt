an text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7035">y de esa manera se distribuye el alto riesgo de una intervención asistida por computadora</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6996">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/></text:p>
