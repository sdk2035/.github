        <text:p text:style-name="P13">Módulos de Desalinización de Agua de Mar </text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P14"><text:a xlink:type="simple" xlink:href="https://es.wikipedia.org/wiki/Generador_atmosférico_de_agua" office:target-frame-name="_blank" xlink:show="new" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="T1">Generadores Atmosféricos de Agua</text:span></text:a><text:span text:style-name="T1"> </text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P13">Talleres Mecatrónicos de Automatización Industrial </text:p>
       </text:list-item>
