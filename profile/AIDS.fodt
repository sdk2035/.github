       <text:list-item>
        <text:p text:style-name="P687"><text:span text:style-name="T205">Experto: </text:span><text:span text:style-name="T1038">Contemplando con detenimiento la fotografía de su esposa</text:span><text:span text:style-name="T1034">.</text:span><text:span text:style-name="T994">..</text:span><text:span text:style-name="T787"> </text:span><text:span text:style-name="T209">&quot;</text:span><text:span text:style-name="T1037">o </text:span><text:span text:style-name="T1039">practicando el buen arte…</text:span><text:span text:style-name="T209">&quot;</text:span><text:bookmark-end text:name="__DdeLink__88400_4187347600"/><text:bookmark-end text:name="__DdeLink__88481_2511362355"/></text:p>
