       <text:list-item>
        <text:p text:style-name="P685"><text:soft-page-break/><text:span text:style-name="T205">Experto: </text:span><text:span text:style-name="T1034">Desde las regiones elevedas, viajaremos al llano.</text:span><text:span text:style-name="T994">..</text:span><text:span text:style-name="T787"> </text:span><text:span text:style-name="T209">&quot;</text:span><text:span text:style-name="T1035">después tomaremos un viaje de crucero y finalmente, desplegamos el submarino…</text:span><text:span text:style-name="T209">&quot;</text:span><text:bookmark-end text:name="__DdeLink__88333_4202230933"/></text:p>
