n><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7059">la </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">policía militar tiene la autoridad para convertir casi cualquier infraestructura civil en una cárcel</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7059">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">solamente será libre cuando construya su propia nave…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/></text:p>
