        </table:table-cell>
        <table:table-cell table:style-name="Table3.A1" office:value-type="string">
         <text:p text:style-name="P196">Tractores de oruga multifuncionales anfibios</text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table3.C2" office:value-type="string">
         <text:p text:style-name="P53">05</text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table3.C2" office:value-type="string">
         <text:p text:style-name="P197">20 000</text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row>
