       <text:list-item>
        <text:p text:style-name="P4684"><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7078">Le gustan más las colonias alemanas en sudámerica</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7055">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7078">¿Se detendrá su labor voluntaria cuando regrese con su amiga?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4684"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7078">La mujer de la selva oriental en el norte tiene una mejor adaptación para al deporte de aventura, en un lugar apartado y tranquilo</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6997">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7078">debemos prepararnos para la competencia de horario flexible con el viaje a la provincia...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7085">el desarrollo de una docena de triciclos aerodinámicos a pedal electríco y recarga solar, podremos financiar por lo menos una unidad para el taxi aéreo ultraseguro con el girodino de despegue corto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7085">por eso no nos detendremos hasta multiplicar la producción por miles de unidades mediante las técnicas de manufactura aditiva aplicada a las microfábricas </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7086">y el turismo de bodas vivencial con la licencia aprobada para un baile</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7085">….</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4685"><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7087">Le gustaba más el disfraz de princesa de la actriz Sofia Jordy cuando era delgada</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7055">?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4685"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7087">El paisaje húmedo y el clima tropical de la selva oriental nos hace pensar en un diseño arquitectónico ecológico, pero con un aislante del ruido a suficiente altura; si bien la dispensa judicial se puede solicitar cerca de la frontera norte, es compatible emplear una tiendita con mosquitero y un </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7087">colchón para evitar los golpes durante el entrenamiento físico de un infante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6997">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7088">recordemos que una </text:span></text:span><text:soft-page-break/><text:span text:style-name="Emphasis"><text:span text:style-name="T7088">adecuada nutrición de proteínas sin exceso de grasas y un refuerzo vitamínico de calcio permite prevenir el dolor de espalda</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4686"><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7089">Todo lo que necesita para practicar la caza deportiva es un utilitario ligero</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7055">?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4686"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7089">Si en la sierra no se habla mucho de un todo terreno anfibio aeortransportable co un sistema de propulsión híbrido electrico convertible a gas natural o hidrógeno</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6997">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7090">es por que todavía se emplea la fuerza animal como medio de transporte para llegar hasta la frontera</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4687"><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7091">A nosotros nos parece que Ud ni es afroamericano ni árabe-asiático, mas bien parece euroselvático</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7055"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7091">¿Es un héroe sin taparrabo?¿Con cuántas casitas podemos rodantes tomar Moscú?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4687"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7091">Como verán, no estoy casado con Rusia ni nos encontramos autorizados para intervenir militarmente en la zona caliente</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6997">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7092">solamente podemos llevar a cabo la jornada de ayuda humanitaria por convenio de nacionalidad múltiple y el límite para la legión extranjera es España</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4688"><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7091">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7093">Nadie negará que hay un asesino cercano a su familia, una mente del delito o piensa retirarse del activo</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7091">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7093">¿El gobierno demócrata derrocará a la tiranía antes que complete la ejecución de una venganza termonuclear?¿Quién más se atrevería a insultar a un estudiante san marquino?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4688"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7093">Los olivos son un símbolo de la paz, pero la condenación de la guerra. Convertiremos a la universidad nacional en un aeropuerto con un proyecto de ingeniería abierta que todos sus estudiantes podrán replicar cuando la unidad de postgrado complete la certificación y el control de calidad, por eso la formación de pilotos para la reserva será masiva</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6997">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7094">no creo en una sociedad que ostente el oligopolio</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7095"> marítimo</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7094"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7096">y la infrastructura deportiva multipropósito servirá como un helipuerto </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7095">de enlace alimentador hasta el cerro</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7096"> con hangar subterráneo y elevador automático</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4689"><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7097">Cuál es el propósito de la inmigración caribeña</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7055">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7097">¿Son los únicos que poseen fronteras con la comunidad europea, pierden la guerra económica o todos son isleños?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">¿Se quedará en la costa o se dedicará a las tareas más básicas de la cadena productiva?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4689"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">En mi novela soy todo lo que quiera ser menos Dios, un ángel o un diablo. En el peor de los casos suponiendo que en el mercado local no exista</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">n</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098"> empleo</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">s</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098"> suficiente</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">s</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098"> para un pescador o transportista, migraremos a la ciudad poblada más próxima con mejor clima, pero s</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7089">i </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7097">exportan mercenarios </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">tan sólo </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7097">para imponer la ley del más fuerte e intimidar a las autoridades legítimas</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6997">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6757"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7100">todo </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7101">hombre </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7100">venezolano que beligere fuera de sus fronteras, será exterminado</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2"/></text:p>
