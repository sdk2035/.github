        <text:p text:style-name="P4690"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">En </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">efecto, tarde o temprano encontrará una buena amiga el día de su cumpleaños...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099"> pero ese barrio americano, sería un buen lugar de inversión ganadera para un gaucho o una inducción básica en la mecánica de fluidos</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4691"><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">L</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7102">legamos a la conclusión que si en el norte nadie lo quiere o las autoridades del callao creen que pueden alterar su novela es por que el Sr. Sánchez es cusqueño</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4691"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7102">No es un fracaso empezar sus estudios de pregrado, continuar en provincia y luego retomarlos, especialmente cuando el posgrado internacional o el doble grado es europeo. </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7102">xisten muchas similitudes entre las principales ciudades de la costa y la sierra, pero indudablemente fuera del valle la vida es un desierto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7102">en cambio en la región cusqueña las áreas verdes son mucho más amplias y con mejor clima, pero no se confíe mucho de la lluvia fría o busque un buen resguardo cerca de la terminal terrestre en la zona alta</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7103">algunas callecitas tradicionales nos recuerdan la fusión criolla de la época colonial y probablemente no encuentre lugar para viajar en el tiempo… más allá de la cohesión con los principios del desarrollo comunitario colaborativo… tenga cuidado con los hospedajes demasiado baratos cerca del centro donde no pueda confiar en su plan de datos por que la señal no es intensa, en época con alta demanda es probable que no encuentre una reserva tan económica o un campamento para pescar fuera de urubamba…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4692"><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7104">Con lo del exterminio se refiere a la falta de aclimatación de su fauna endógena o es un problema de mimetización con el medio ambiente</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7098">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7104">¿El espíritu de venganza conduce al fracaso?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4692"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7104">Imagine cuán asimétrico sería beligerar contra un billón de almas, contabilizando a la </text:span></text:span><text:soft-page-break/><text:span text:style-name="Emphasis"><text:span text:style-name="T7104">posible alianza entre los estados unidos, la comunidad europea y la federación brasileña. Nadie puede lastimar a su primo lejano sin que en el fondo se lamente por ello</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">pero </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7104">tradicionalmente la influencia étnica nos conduce a considerar a la provincia argentina como una nación hermana</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4693"><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">¿Todo lo que necesita es un paraguas?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7000">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">El cusco es un lugar inmejorable para la inversión aeronáutica</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7104"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">o todos los turistas cajamarquinos se sienten emparentados con la nobleza?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4693"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">La belleza paisajística en las afueras de la ciudad sólo se compara con la región templada argentina y la lozanía de sus jovencitas, pero con mejor clima</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7099">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">un lugar ideal para formar una familia… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">cerca del futuro aeropuerto de chincheros se cotizan lotes desde los 20 mil soles con posibilidades de financiamiento directo a un plazo anual y enlace con la carretera interoceánica</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1"/></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4694"><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7106">Alguna otra advertencia sobre el riesgo del clima</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7107">¿Un aeropuerto en construcción sólo requiere de un modelo virtual de simulación o l</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7108">o que realmente necesita es una vara de andinista para defenderse de </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7107">un</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7108"> puma </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7107">nocturno</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7108">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7106">¿Qué pensaría su amiguita sobre todo esto?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4694"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7106">El acceso a la fortaleza incaica es una trampa, por que cuando llueve fuerte la quebrada seca se convierte en el sorpresivo torrente de una rebelde cascada</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7106">pero ella dirá… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7109">toda conversación fuera de la universidad es vana, solamente la suya es ocurrente; aunque me encuentre aburrid</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7110">a</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7109"> o con una mirada él sepa lo que piens</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7110">e</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7061">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7109">bastará una sonrisita </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7110">mía</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7109"> y ya lo tengo…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1"/></text:p>
