/text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T10006">o requer</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T10037">irán</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T10006"> menos </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T10037">portátiles</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T10006">?</text:span></text:span></text:p>
