        <text:p text:style-name="P4698"><text:bookmark-start text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-start text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-start text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">E</text:span></text:span><text:bookmark-start text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6196">studiante</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6574">: </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7105">¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129">No sale rentable dedicarse como agente comercial con un ingreso proporcional a las ventas</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7112">?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129">¿Gana más el jovencito que viene de cusco o el veterano porteño que regresa a provincia?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">¿Invertirá dos mil soles en las cómodas oficinas empresariales del edificio Amauta o en la academia de enfrente con el alojamiento de internado?¿Alternará la traducción de textos científicos en euroidiomas?¿</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">Con respecto a los ángeles se refiere a la calle de los siete borreguitos o c</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">ontinuará con el ceba gratuito en el turno nocturno del colegio de ciencias?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7132">¿Tradicionalmente la debilidad del imperio incaico es su fuerza aérea?</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">Si no se respetan los derechos laborales de los jóvenes estudiantes ¿Se debe invertir más en la industria </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7132">de la aeronáutica</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131"> militar para la reserva?</text:span></text:span></text:p>
       </text:list-item>
       <text:list-item>
        <text:p text:style-name="P4698"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173417_406171522411111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-end text:name="__DdeLink__173307_3472963148131111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-end text:name="__DdeLink__173375_212226562421111111121111111111111111111112121112122121211121213311111122131212122121121122111211113211111111111111114112111123111111111111112211111111112111111111111111111132112131132121111111111111211111212111111111211211111111121112 Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">La realidad es esta, </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">si nos enfocamos en la asimilación de la tecnología americana es por que no necesitamos de la legión extranjera y</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">si no fuera por las minas de polimetales, la ruta corta arequipeña no valdría la pena;</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">la inyeccion de capitales derivados del tur</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7132">ismo matrimonial</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131"> se debe </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7132">principalmente</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131"> a que</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130"> la ubicación cusqueña resulta idónea para la seguridad integral de una fábrica de aviones, ni tan caliente de día o fría por las </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">noches</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">… e</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129">l </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">piloto no requiere de una universidad y al grupo de estudio no se le puede denegar la licencia deportiva...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">el </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129">himno del estudiante universitario y mochilero será el siguiente… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7131">después de las doce</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129"> resguardo atento mi equipaje valioso, pero de día reflexiono sobre mis tare</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">a</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129">s </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7130">pendientes</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129"> en la biblioteca pública… a mis casi cuarenta años de edad o más de cinco de experiencia </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7132">especializada</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7106">, </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7129">con tan solo 100 dólares me hago mil en un fin de semana...</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7133">mi único vicio es la goma de mascar</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7109">, </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7133">tan dulce o ácida al mismo tiempo; pero similar a un beso apasionado después de una tarde de cine o un baile romántico </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7134">de cumpleaños</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7133">…</text:span></text:span><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 2 Copy 1 Copy 2 Copy 1 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3"/></text:p>
