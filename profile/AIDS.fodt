       <text:list-item>
        <text:p text:style-name="P4812"><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">E</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6761">xperto</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6764">:</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7021"> </text:span></text:span><text:bookmark-end text:name="__DdeLink__173375_2122265624211111111211111111111111111111121211121221212111212133111111221312121221211211221112111132111111111111111141121111231111 Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__155131_ Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173417_4061715224111111111211111111111111111111121211121221212111212133111111221312121221211211221112111132111111111111111141121111231111 Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__173307_34729631481311111111211111111111111111111121211121221212111212133111111221312121221211211221112111132111111111111111141121111231111 Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T7415">En ese caso, siempre que se cuente con la autorización <text:s/>legal</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7389">…</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7392"> </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T6200">“</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7413">l</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7416">a colaboración con Australia podría darse desde los Emiratos Árabes <text:s/>Unidos</text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7406">… </text:span></text:span><text:span text:style-name="Emphasis"><text:span text:style-name="T7416">por que el transporte flexible modular, no solamente disminuirá el nivel de contaminación en la capital; sino que incrementará la salud de sus niñas, así como la belleza del paisaje desértico minimizando las complicaciones bronquiales…</text:span></text:span><text:bookmark-start text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-start text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:span text:style-name="Emphasis"><text:span text:style-name="T6195">&quot;</text:span></text:span><text:bookmark-end text:name="__DdeLink__108668_ Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__107024_ Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/><text:bookmark-end text:name="__DdeLink__188749_3495873704 Copy 1 Copy 1 Copy 4 Copy 2 Copy 2 Copy 2 Copy 2 Copy 1 Copy 1 Copy 1 Copy 3 Copy 2 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1 Copy 1"/></text:p>
